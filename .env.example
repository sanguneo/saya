# Read only by the local Vite development proxy or the external reverse proxy.
# These names deliberately do not use VITE_: they must never enter the browser bundle.
SAYA_CORE_URL=http://127.0.0.1:8765
SAYA_CORE_TOKEN=replace-with-a-secret-from-your-password-manager

# Messenger adapters (tsuba), one upstream each. The browser sees only the ids;
# each address and token stays in the proxy. Leave SAYA_ADAPTERS empty for none.
SAYA_ADAPTERS=telegram
SAYA_ADAPTER_TELEGRAM_URL=https://adapter-host.example-tailnet.ts.net:8790
SAYA_ADAPTER_TELEGRAM_TOKEN=replace-with-the-adapter-token-from-its-env

# Optional 문의 모아보기 reply help (docs/deployment.md): one file says whose tone,
# which prefix, where the KakaoTalk core is, and which model/checker. Keys stay
# out of it: the model key is the env variable it names, JEV's a file it names.
# SAYA_ASSIST_CONFIG=deploy/assist.config.example.json
# SAYA_ASSIST_LLM_KEY=replace-with-a-secret-from-your-password-manager

# Production (bun server/serve.ts) needs none of the above: cores and adapters
# register themselves with this one token (docs/register.md).
# SAYA_REGISTER_TOKEN=replace-with-at-least-32-random-characters
