{
    # Do not emit request headers, bodies, or message text to access or error logs.
    log default {
        output discard
    }
}

# Loopback-only default. For remote use, replace both this site address and the
# Origin matcher below with the same HTTPS public origin after adding separate
# user authentication. Do not expose the core or this listener directly.
http://127.0.0.1:8080 {
    root * dist
    encode zstd gzip

  # `route` keeps the directives below in the order written. Without it Caddy
  # sorts them: try_files would rewrite /api and /adapters to /index.html before
  # any handle runs, and `respond @blocked_write` would run after the handles,
  # letting a cross-site write through.
  route {
    # A default only (`?`): an upstream answer such as /media keeps its own.
    # Hashed assets and /api override it below.
    header ?Cache-Control "no-cache"
    # img-src allows https: because a photo on a message is an address on the
    # client's own CDN, which the contract says the browser may use directly.
    # connect-src adds the theme gallery's catalog (saya-themes on GitHub Pages,
    # VITE_THEME_GALLERY_URL at build time); drop it to turn the gallery off.
    # Scripts and styles stay 'self'; nothing else is widened.
    header Content-Security-Policy "default-src 'self'; connect-src 'self' https://heoooooon.github.io; img-src 'self' https: data:; worker-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; script-src 'self'; style-src 'self'"

    @api path /api/*
    header @api >Cache-Control "no-store"

    # saya's server (server/serve.ts, deploy/saya-server.service) answers
    # /unfurl, /api and /adapters on loopback 8791. It has no authentication
    # on this side; this listener is what fronts it, after the write rules
    # below. /unfurl is the link-preview endpoint, not the cores' contract.
    @unfurl path /unfurl /unfurl/*
    handle @unfurl {
        reverse_proxy 127.0.0.1:8791
    }

    # Browser writes must demonstrably originate at this site and be JSON, or
    # be a file upload: multipart, and only on the two upload routes. A write
    # is blocked unless one of the two `not` blocks holds; the inverse match
    # fails closed when Origin or Fetch Metadata is absent.
    @blocked_write {
        method POST PUT PATCH DELETE
        not {
            header Origin http://127.0.0.1:8080
            header Sec-Fetch-Site same-origin
            header Content-Type application/json*
        }
        not {
            path_regexp upload_write ^/(?:api|adapters/[a-z][a-z0-9-]*)/upload$
            header Origin http://127.0.0.1:8080
            header Sec-Fetch-Site same-origin
            header Content-Type multipart/form-data*
        }
    }
    respond @blocked_write 403

    # An upload is bounded here too, above the largest maxBytes a core or an
    # adapter declares (50 MB): no more than this is passed on, whatever the
    # request claims. The core or adapter refuses a file past its own limit
    # with 400, from the declared length or while it reads.
    @upload_body path_regexp upload_body ^/(?:api|adapters/[a-z][a-z0-9-]*)/upload$
    request_body @upload_body {
        max_size 60MiB
    }

    # The KakaoTalk core and the messenger adapters are whoever registered
    # with saya's server (docs/register.md); it strips /api or
    # /adapters/<id>, adds the token each one registered, and answers the
    # /adapters index with ids only. No address or token is written here.
    # Send each SSE chunk immediately, and add no stream/idle timeout: neither
    # contract specifies a ping cadence.
    handle @api {
        reverse_proxy 127.0.0.1:8791 {
            flush_interval -1
        }
    }

    # Adapter answers include bytes somebody else sent (`/media`): sandboxed
    # and never sniffed after the upstream's own headers, here as well as in
    # saya's server. `/media` keeps its own private cache header.
    @adapters path /adapters /adapters/*
    header @adapters {
        ?Cache-Control "no-store"
        >Content-Security-Policy "default-src 'none'; sandbox"
        >X-Content-Type-Options "nosniff"
    }
    handle @adapters {
        reverse_proxy 127.0.0.1:8791 {
            flush_interval -1
        }
    }

    # Optional (docs/deployment.md): saya's server answers /summary only when
    # SAYA_SUMMARY_URL and SAYA_SUMMARY_MODEL are set, and 404 otherwise. Its
    # POST is a write, so it sits after the write rules above.
    @summary path /summary
    handle @summary {
        reverse_proxy 127.0.0.1:8791
    }

    @hashed_assets path_regexp hashed ^/assets/.+\.[a-zA-Z0-9_-]{8,}\.(?:css|js|mjs|woff2?|svg|png|jpe?g|webp|gif)$
    header @hashed_assets Cache-Control "public, max-age=31536000, immutable"

    # Everything else is the static client, with the SPA fallback.
    handle {
        try_files {path} /index.html
        file_server
    }
  }
}
